# =============================================================================
# CineLog API – Mídia                                             [media.http]
# =============================================================================
# Base paths:
#   /api/v1/media          – CRUD versionado (requer autenticação)
#   /api/v1/admin/media    – criação privilegiada (role ADMIN)
#   /api/media/search      – busca facetada (público)
#   /api/media/search/text – busca textual simples (público)
#
# ┌─────────────────────────────────────────────────────────────────────────┐
# │ PRÉ-REQUISITO: Execute login em auth.http e cole o token em @token        │
# │ Para admin: configure @adminToken também                                 │
# └─────────────────────────────────────────────────────────────────────────┘
# =============================================================================

# ─── Variáveis (edite conforme necessário) ───────────────────────────────────
@baseUrl = http://localhost:8080
@token = REPLACE_AFTER_LOGIN
@adminToken = REPLACE_AFTER_ADMIN_LOGIN
@mediaId = 1

# ─────────────────────────────────────────────────────────────────────────────
# CRUD – /api/v1/media
# ─────────────────────────────────────────────────────────────────────────────

###
# @name createMedia
# Cria uma nova mídia (filme ou série). Requer autenticação.
# → 201 Created  (corpo: MediaResponse com id gerado)
# → 400 Bad Request (validação: title obrigatório, type inválido, etc.)
POST {{baseUrl}}/api/v1/media
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "title": "Inception",
  "type": "MOVIE",
  "releaseYear": 2010,
  "originalTitle": "Inception",
  "originalLanguage": "en",
  "posterUrl": "https://example.com/posters/inception.jpg",
  "backdropUrl": "https://example.com/backdrops/inception.jpg",
  "overview": "A thief who steals corporate secrets through dream-sharing technology.",
  "tmdbId": 27205
}


###
# @name listMedia
# Lista mídias com paginação.
# → 200 OK (corpo: PageResponse<MediaResponse>)
GET {{baseUrl}}/api/v1/media?page=0&size=20&sort=id,asc
Authorization: Bearer {{token}}


###
# @name getMediaById
# Busca uma mídia pelo ID.
# → 200 OK | 404 Not Found
GET {{baseUrl}}/api/v1/media/{{mediaId}}
Authorization: Bearer {{token}}


###
# @name updateMedia
# Atualiza uma mídia existente.
# → 200 OK | 404 Not Found | 400 Bad Request
PUT {{baseUrl}}/api/v1/media/{{mediaId}}
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "title": "Inception (Updated)",
  "type": "MOVIE",
  "releaseYear": 2010,
  "originalTitle": "Inception",
  "originalLanguage": "en",
  "posterUrl": "https://example.com/posters/inception-v2.jpg",
  "backdropUrl": "https://example.com/backdrops/inception-v2.jpg",
  "overview": "Updated overview for Inception.",
  "tmdbId": 27205
}


###
# @name deleteMedia
# Remove uma mídia pelo ID.
# → 204 No Content | 404 Not Found
DELETE {{baseUrl}}/api/v1/media/{{mediaId}}
Authorization: Bearer {{token}}


###
# @name searchMediaUseCase
# Busca avançada via body (use-case level) em /api/v1/media/searchUC.
# Todos os campos são opcionais – remova qualquer um para ampliar a busca.
# Campos de paginação: page (default 0), size (default 10), sortBy, sortDirection
# → 200 OK (corpo: PageResponse<MediaResponse>)
POST {{baseUrl}}/api/v1/media/searchUC
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "text": "inception",
  "type": "MOVIE",
  "yearMin": 2000,
  "yearMax": 2023,
  "ratingMin": 7.0,
  "ratingMax": 10.0,
  "genreIds": [1, 3],
  "page": 0,
  "size": 10,
  "sortBy": "releaseYear",
  "sortDirection": "DESC"
}


# ─────────────────────────────────────────────────────────────────────────────
# ADMIN – /api/v1/admin/media  (ADMIN role required)
# ─────────────────────────────────────────────────────────────────────────────

###
# @name adminCreateMedia
# Criação de mídia via endpoint admin. Requer role ADMIN.
# → 201 Created | 403 Forbidden (se token != ADMIN)
POST {{baseUrl}}/api/v1/admin/media
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{
  "title": "The Dark Knight",
  "type": "MOVIE",
  "releaseYear": 2008,
  "originalTitle": "The Dark Knight",
  "originalLanguage": "en",
  "posterUrl": "https://example.com/posters/dark-knight.jpg",
  "backdropUrl": "https://example.com/backdrops/dark-knight.jpg",
  "overview": "Batman raises the stakes in his war on crime.",
  "tmdbId": 155
}


# ─────────────────────────────────────────────────────────────────────────────
# Search – /api/media  (public, no auth required)
# ─────────────────────────────────────────────────────────────────────────────

###
# @name searchMediaFaceted
# Busca facetada/filtrada de mídias. Todos os query params são opcionais.
# → 200 OK (corpo: PageResponse<MediaResponse>)
GET {{baseUrl}}/api/media/search?text=inception&type=MOVIE&yearMin=2000&yearMax=2023&ratingMin=7.0&ratingMax=10.0&genreIds=1&genreIds=3&page=0&size=20&sort=id&direction=ASC


###
# @name searchMediaText
# Busca textual simples por query string.
# → 200 OK
GET {{baseUrl}}/api/media/search/text?q=inception
