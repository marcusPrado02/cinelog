# =============================================================================
# GENRE SPOTLIGHT
# =============================================================================

###
# @name previewGenreSpotlight
# Preview: análise profunda de um gênero.
# Espera: 200 OK + JSON com dados do gênero
GET {{baseUrl}}/api/v1/reports/genre-spotlight?genre=Action
Authorization: Bearer {{token}}
Accept: application/json

###
# @name sendGenreSpotlightToSelf
# Envia relatório genre-spotlight ao e-mail do usuário autenticado.
# Espera: 202 Accepted
POST {{baseUrl}}/api/v1/reports/genre-spotlight
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "genre": "Action"
}

###
# @name sendGenreSpotlightToEmail
# Envia relatório genre-spotlight a um endereço explícito.
# Espera: 202 Accepted
POST {{baseUrl}}/api/v1/reports/genre-spotlight
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "email": "{{testEmail}}",
  "genre": "Drama"
}

###
# @name pdfGenreSpotlight
# 📄 Download PDF genre-spotlight.
# Espera: 200 OK + application/pdf
GET {{baseUrl}}/api/v1/reports/genre-spotlight/pdf?genre=Action
Authorization: Bearer {{token}}
Accept: application/pdf


# =============================================================================
# PLATFORM REPORT (ADMIN)
# =============================================================================

###
# @name previewPlatformReport
# Preview: relatório geral da plataforma — requer role ADMIN.
# Espera: 200 OK + métricas globais
GET {{baseUrl}}/api/v1/admin/reports/platform
Authorization: Bearer {{adminToken}}
Accept: application/json

###
# @name sendPlatformReport
# Envia relatório de plataforma a um e-mail — requer role ADMIN.
# Espera: 202 Accepted
POST {{baseUrl}}/api/v1/admin/reports/platform
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "email": "{{testEmail}}"
}

###
# @name sendPlatformReportForbidden
# Acesso sem token de admin → deve retornar 403 Forbidden.
POST {{baseUrl}}/api/v1/admin/reports/platform
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "email": "{{testEmail}}"
}

###
# @name pdfPlatformReport
# 📄 Download PDF do relatório de plataforma (landscape).
# Requer role ADMIN. Espera: 200 OK + application/pdf
GET {{baseUrl}}/api/v1/admin/reports/platform/pdf
Authorization: Bearer {{adminToken}}
Accept: application/pdf

###
# @name pdfPlatformReportForbidden
# PDF platform sem admin token → deve retornar 403 Forbidden.
GET {{baseUrl}}/api/v1/admin/reports/platform/pdf
Authorization: Bearer {{token}}
Accept: application/pdf


# =============================================================================
# SEND-TO-ALL (ADMIN)
# =============================================================================

###
# @name sendTrendingToAll
# ⚠️  ATENÇÃO: dispara e-mail para TODOS os usuários ativos!
# Use apenas em ambiente de testes com MailHog ativo.
# Requer role ADMIN. Espera: 202 Accepted.
POST {{baseUrl}}/api/v1/admin/reports/send-to-all
Authorization: Bearer {{adminToken}}
Content-Type: application/json

###
# @name sendToAllForbidden
# Tentativa de envio em massa sem role ADMIN → deve retornar 403.
POST {{baseUrl}}/api/v1/admin/reports/send-to-all
Authorization: Bearer {{token}}
Content-Type: application/json
