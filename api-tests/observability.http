# =============================================================================
# CineLog API – Observabilidade & Métricas                [observability.http]
# =============================================================================
#
#  Endpoints cobertos:
#   GET /actuator/health              → Liveness / readiness da aplicação
#   GET /actuator/info                → Metadados do build
#   GET /actuator/metrics             → Lista todas as métricas Micrometer
#   GET /actuator/metrics/{name}      → Valor de uma métrica específica
#   GET /actuator/prometheus          → Scrape endpoint para Prometheus
#   GET /actuator/caches              → Estado das caches Redis/Caffeine
#   POST /actuator/loggers/{name}     → Altera nível de log em runtime
#
#  Métricas de segurança (cinelog.security.*):
#   auth_failures_total  · account_lockouts_total · jwt_failures_total
#   rate_limit_total     · sqli_attempts_total    · access_denied_total
#   tamper_detected_total · sensitive_access_total
#
#  Métricas de negócio (cinelog.business.*):
#   watch_entries_created_total · reports_sent_total
#   recommendations_generated_total · searches_total
#
# ┌──────────────────────────────────────────────────────────────────────────┐
# │ PRÉ-REQUISITOS                                                           │
# │  1. Faça login em auth.http → copie o accessToken → cole em @token      │
# │  2. Para rate-limit: execute os blocos "rateLimitTrigger" em sequência  │
# │  3. Grafana local: http://localhost:3000  (admin/admin)                  │
# └──────────────────────────────────────────────────────────────────────────┘
# =============================================================================

# ─── Variáveis ────────────────────────────────────────────────────────────────
@baseUrl    = http://localhost:8080
@token      = REPLACE_AFTER_LOGIN
@adminToken = REPLACE_WITH_ADMIN_TOKEN


# =============================================================================
# ACTUATOR – Saúde & Informações
# =============================================================================

###
# @name health
# Health check completo (db + redis + kafka + disk).
# Espera: 200 OK + status UP para todos os componentes
GET {{baseUrl}}/actuator/health
Accept: application/json

###
# @name healthLiveness
# Liveness probe (Kubernetes-style).
GET {{baseUrl}}/actuator/health/liveness
Accept: application/json

###
# @name healthReadiness
# Readiness probe.
GET {{baseUrl}}/actuator/health/readiness
Accept: application/json

###
# @name info
# Metadados do build (versão, git commit, Java version).
GET {{baseUrl}}/actuator/info
Accept: application/json


# =============================================================================
# ACTUATOR – Métricas (Micrometer)
# =============================================================================

###
# @name metricsList
# Lista todas as métricas registradas no Micrometer.
# Espera: 200 OK + { "names": [...] }
GET {{baseUrl}}/actuator/metrics
Authorization: Bearer {{adminToken}}
Accept: application/json

###
# @name metricsHttpRequests
# Total de requisições HTTP por status/método/URI.
GET {{baseUrl}}/actuator/metrics/http.server.requests
Authorization: Bearer {{adminToken}}
Accept: application/json

###
# @name metricsJvmMemory
# Uso de memória JVM (heap utilizado).
GET {{baseUrl}}/actuator/metrics/jvm.memory.used
Authorization: Bearer {{adminToken}}
Accept: application/json

###
# @name metricsJvmThreads
# Número de threads JVM ativas.
GET {{baseUrl}}/actuator/metrics/jvm.threads.live
Authorization: Bearer {{adminToken}}
Accept: application/json


# =============================================================================
# MÉTRICAS DE SEGURANÇA (cinelog.security.*)
# =============================================================================

###
# @name securityAuthFailures
# Total de falhas de autenticação (todas as razões).
GET {{baseUrl}}/actuator/metrics/cinelog.security.auth_failures_total
Authorization: Bearer {{adminToken}}
Accept: application/json

###
# @name securityAuthFailuresInvalidCredentials
# Falhas por credenciais inválidas — filtra pela tag reason.
GET {{baseUrl}}/actuator/metrics/cinelog.security.auth_failures_total?tag=reason:invalid_credentials
Authorization: Bearer {{adminToken}}
Accept: application/json

###
# @name securityAccountLockouts
# Total de bloqueios de conta por brute-force.
GET {{baseUrl}}/actuator/metrics/cinelog.security.account_lockouts_total
Authorization: Bearer {{adminToken}}
Accept: application/json

###
# @name securityJwtFailures
# Total de falhas de validação JWT.
GET {{baseUrl}}/actuator/metrics/cinelog.security.jwt_failures_total
Authorization: Bearer {{adminToken}}
Accept: application/json

###
# @name securityJwtFailuresExpired
# JWT expirado.
GET {{baseUrl}}/actuator/metrics/cinelog.security.jwt_failures_total?tag=reason:expired
Authorization: Bearer {{adminToken}}
Accept: application/json

###
# @name securityRateLimit
# Total de requisições bloqueadas por rate-limit.
GET {{baseUrl}}/actuator/metrics/cinelog.security.rate_limit_total
Authorization: Bearer {{adminToken}}
Accept: application/json

###
# @name securitySqlInjection
# Tentativas de SQL Injection detectadas.
GET {{baseUrl}}/actuator/metrics/cinelog.security.sqli_attempts_total
Authorization: Bearer {{adminToken}}
Accept: application/json

###
# @name securityAccessDenied
# Total de acessos negados (403).
GET {{baseUrl}}/actuator/metrics/cinelog.security.access_denied_total
Authorization: Bearer {{adminToken}}
Accept: application/json

###
# @name securityTamperDetected
# Tentativas de adulteração detectadas.
GET {{baseUrl}}/actuator/metrics/cinelog.security.tamper_detected_total
Authorization: Bearer {{adminToken}}
Accept: application/json

###
# @name securitySensitiveAccess
# Acessos a recursos sensíveis rastreados.
GET {{baseUrl}}/actuator/metrics/cinelog.security.sensitive_access_total
Authorization: Bearer {{adminToken}}
Accept: application/json


# =============================================================================
# MÉTRICAS DE NEGÓCIO (cinelog.business.*)
# =============================================================================

###
# @name businessWatchEntries
# Total de entries de watch registradas.
GET {{baseUrl}}/actuator/metrics/cinelog.business.watch_entries_created_total
Authorization: Bearer {{adminToken}}
Accept: application/json

###
# @name businessReportsSent
# Total de relatórios enviados por e-mail (todos os tipos).
GET {{baseUrl}}/actuator/metrics/cinelog.business.reports_sent_total
Authorization: Bearer {{adminToken}}
Accept: application/json

###
# @name businessRecommendations
# Total de recomendações geradas.
GET {{baseUrl}}/actuator/metrics/cinelog.business.recommendations_generated_total
Authorization: Bearer {{adminToken}}
Accept: application/json

###
# @name businessSearches
# Total de buscas realizadas.
GET {{baseUrl}}/actuator/metrics/cinelog.business.searches_total
Authorization: Bearer {{adminToken}}
Accept: application/json


# =============================================================================
# PROMETHEUS SCRAPE
# =============================================================================

###
# @name prometheusScrape
# Endpoint de scrape no formato Prometheus (text/plain).
# Espera: 200 OK + linhas "# HELP / # TYPE / cinelog_..."
GET {{baseUrl}}/actuator/prometheus
Authorization: Bearer {{adminToken}}
Accept: text/plain


# =============================================================================
# CACHES
# =============================================================================

###
# @name cachesList
# Lista todas as caches registradas (Redis + Caffeine).
GET {{baseUrl}}/actuator/caches
Authorization: Bearer {{adminToken}}
Accept: application/json

###
# @name cacheEvictAll
# Invalida TODAS as caches. Use com cuidado em produção!
# Espera: 200 OK sem body
DELETE {{baseUrl}}/actuator/caches
Authorization: Bearer {{adminToken}}


# =============================================================================
# LOG LEVELS (runtime)
# =============================================================================

###
# @name logLevelRoot
# Consulta o nível de log atual do logger raiz.
GET {{baseUrl}}/actuator/loggers/ROOT
Authorization: Bearer {{adminToken}}
Accept: application/json

###
# @name logLevelSecurity
# Consulta o nível do logger de segurança CineLog.
GET {{baseUrl}}/actuator/loggers/com.cinelog.infrastructure.security
Authorization: Bearer {{adminToken}}
Accept: application/json

###
# @name setLogLevelDebug
# Eleva o log de segurança para DEBUG em runtime (sem restart).
# Espera: 204 No Content
POST {{baseUrl}}/actuator/loggers/com.cinelog.infrastructure.security
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "configuredLevel": "DEBUG"
}

###
# @name resetLogLevelInfo
# Retorna o log de segurança para INFO.
POST {{baseUrl}}/actuator/loggers/com.cinelog.infrastructure.security
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "configuredLevel": "INFO"
}


# =============================================================================
# RATE-LIMIT TRIGGER
# Execute estes blocos em sequência rápida para acionar o bloqueio e verificar
# o contador cinelog.security.rate_limit_total (deve incrementar após o 10º).
# =============================================================================

###
# @name rateLimitTrigger01
# Disparo 1/11 — credencial errada proposital
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{ "username": "ratelimit_test_user", "password": "wrong_pass" }

###
# @name rateLimitTrigger02
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{ "username": "ratelimit_test_user", "password": "wrong_pass" }

