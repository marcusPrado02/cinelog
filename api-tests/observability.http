POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{ "username": "ratelimit_test_user", "password": "wrong_pass" }

###
# @name rateLimitTrigger11
# 11ª tentativa → deve retornar 429 Too Many Requests
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{ "username": "ratelimit_test_user", "password": "wrong_pass" }

###
# @name verifyRateLimitCounter
# O counter deve ter incrementado após os disparos acima.
GET {{baseUrl}}/actuator/metrics/cinelog.security.rate_limit_total
Authorization: Bearer {{adminToken}}
Accept: application/json
