# ========= Banco de Dados =========
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/cinelog?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
SPRING_DATASOURCE_USERNAME=cinelog
SPRING_DATASOURCE_PASSWORD=cinelog

# ========= Redis (Cache) =========
SPRING_DATA_REDIS_HOST=localhost
SPRING_DATA_REDIS_PORT=6379

# ========= Perfil Spring =========
SPRING_PROFILES_ACTIVE=dev

# ========= Segurança JWT =========
# Altere para uma chave secreta forte com pelo menos 32 caracteres
CINELOG_SECURITY_JWT_SECRET=MINHA_CHAVE_MEGA_SECRETA_DE_NO_MINIMO_32_CHARS
CINELOG_SECURITY_JWT_EXPIRATION_SECONDS=3600

# ========= TMDB API (The Movie Database) =========
# Obtenha sua chave em: https://www.themoviedb.org/settings/api
TMDB_API_KEY=coloque_sua_key_aqui

# ========= Observabilidade (OpenTelemetry) =========
MANAGEMENT_OTLP_TRACING_ENDPOINT=http://localhost:4318/v1/traces