    <!-- Add version column to media table -->
    <changeSet id="20251212030000-1" author="maps">
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="media" columnName="version" />
            </not>
        </preConditions>

        <addColumn tableName="media">
            <column name="version" type="BIGINT" defaultValue="0">
                <constraints nullable="false" />
            </column>
        </addColumn>
    </changeSet>

