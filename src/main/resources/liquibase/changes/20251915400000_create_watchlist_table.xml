<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.23.xsd">

    <changeSet id="20251915400000-1" author="maps">
        <createTable tableName="watchlist">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" />
            </column>

            <column name="user_id" type="BIGINT">
                <constraints nullable="false" />
            </column>

            <column name="media_id" type="BIGINT">
                <constraints nullable="false" />
            </column>

            <column name="added_at" type="DATETIME(6)">
                <constraints nullable="false" />
            </column>
        </createTable>

        <addUniqueConstraint
            tableName="watchlist"
            columnNames="user_id, media_id"
            constraintName="uk_watchlist_user_media" />
    </changeSet>
</databaseChangeLog>