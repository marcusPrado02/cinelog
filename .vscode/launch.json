{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "type": "java",
            "name": "Debug CinelogApplication (dev)",
            "request": "launch",
            "mainClass": "com.cine.cinelog.CinelogApplication",
            "projectName": "cinelog",
            "console": "integratedTerminal",
            "internalConsoleOptions": "neverOpen",
            "shortenCommandLine": "auto",
            // Carrega variáveis sensíveis do .env (gitignored — nunca commite credenciais)
            // Copie .env.example para .env e preencha os valores reais
            "envFile": "${workspaceFolder}/.env",
            "vmArgs": "-Dspring.profiles.active=dev"
        },
        {
            "type": "java",
            "name": "Current File",
            "request": "launch",
            "mainClass": "${file}"
        }
    ]
}
